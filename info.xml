<?xml version="1.0"?>
<extension key="com.skvare.payments" type="module">
  <file>payments</file>
  <name>Bulk Payment Retry</name>
  <description>Replays logged PayPal and legacy Authorize.Net payment notifications for a list of transaction IDs, so payments whose notification failed get recorded. Skips notifications whose payment is already recorded.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Sunil Pawar</author>
    <email>sunil@skvare.com</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/Skvare/com.skvare.payments</url>
    <url desc="Documentation">https://github.com/Skvare/com.skvare.payments/blob/civicrm_6_16/README.md</url>
    <url desc="Support">https://github.com/Skvare/com.skvare.payments/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-10-22</releaseDate>
  <version>1.2.0</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>6.16</ver>
  </compatibility>
  <php_compatibility>
    <ver>8.2</ver>
    <ver>8.3</ver>
  </php_compatibility>
  <smarty_compatibility>
    <ver>5</ver>
  </smarty_compatibility>
  <requires>
    <ext>nz.co.fuzion.notificationlog</ext>
  </requires>
  <comments>Replays only what NotificationLog.retry supports (PayPal, PayPal Standard, legacy Authorize.Net). See README.md.</comments>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
  </classloader>
  <civix>
    <namespace>CRM/Payments</namespace>
    <format>26.10.3</format>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
  </mixins>
</extension>
